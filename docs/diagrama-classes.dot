digraph SaneaTech {
  graph [rankdir=LR, bgcolor="white", nodesep="0.55", ranksep="1.45", splines=polyline,
         pad="0.3", margin="0.2", fontname="Helvetica", outputorder=edgesfirst];
  node [shape=plaintext, margin=0];
  edge [color="#177E89", penwidth=1.7, fontcolor="#34516D", fontsize=11, fontname="Helvetica",
        arrowsize=0.6, labelfontsize=11];

cidadao [label=<<TABLE BORDER="1" COLOR="#B6C6D9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#17365D" CELLPADDING="10"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="14"><B>Cidadão</B></FONT><BR/><FONT COLOR="#CFE5F7" POINT-SIZE="9">«Entity» / @Entity</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>ATRIBUTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- nome: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- email: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- telefone: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- ocorrencias: List&lt;Ocorrencia&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>MÉTODOS DE DOMÍNIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ corrigirNome(nome: String): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ atualizarContato(email, telefone): void</FONT></TD></TR></TABLE>>];
equipe [label=<<TABLE BORDER="1" COLOR="#B6C6D9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#17365D" CELLPADDING="10"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="14"><B>Equipe Responsável</B></FONT><BR/><FONT COLOR="#CFE5F7" POINT-SIZE="9">«Entity» / @Entity</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>ATRIBUTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- nome: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- areaAtuacao: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- ocorrencias: List&lt;Ocorrencia&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- alteracoesRegistradas: List&lt;HistoricoStatus&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>MÉTODOS DE DOMÍNIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ renomear(nome: String): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ alterarAreaAtuacao(area: String): void</FONT></TD></TR></TABLE>>];
ocorrencia [label=<<TABLE BORDER="1" COLOR="#B6C6D9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#124B6D" CELLPADDING="10"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="14"><B>Ocorrência</B></FONT><BR/><FONT COLOR="#CFE5F7" POINT-SIZE="9">«Entity» / @Entity</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>ATRIBUTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- protocolo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- tipo: TipoOcorrencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- descricao: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- status: StatusOcorrencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- criadoEm: Instant</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- atualizadoEm: Instant</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- endereco: EnderecoOcorrencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- solicitante: Cidadao</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- equipeResponsavel: EquipeResponsavel [0..1]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- historico: List&lt;HistoricoStatus&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>MÉTODOS DE DOMÍNIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ abrir(solicitante, tipo, descricao, endereco): Ocorrencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ atribuirEquipe(equipe): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ atualizarDescricao(descricao): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ corrigirLocalizacao(endereco): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ iniciarAtendimento(observacao): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">+ concluirAtendimento(observacao): void</FONT></TD></TR></TABLE>>];
historico [label=<<TABLE BORDER="1" COLOR="#B6C6D9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#386C84" CELLPADDING="10"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="14"><B>Histórico de Status</B></FONT><BR/><FONT COLOR="#CFE5F7" POINT-SIZE="9">«Entity» / @Entity</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>ATRIBUTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- statusAnterior: StatusOcorrencia [0..1]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- statusNovo: StatusOcorrencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- observacao: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- registradoEm: Instant</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- ocorrencia: Ocorrencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- equipeResponsavel: EquipeResponsavel [0..1]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>MÉTODOS DE DOMÍNIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">Imutável: sem modificadores públicos</FONT></TD></TR></TABLE>>];
endereco [label=<<TABLE BORDER="1" COLOR="#B6C6D9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#386C84" CELLPADDING="10"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="14"><B>Endereço da Ocorrência</B></FONT><BR/><FONT COLOR="#CFE5F7" POINT-SIZE="9">«Embeddable» / @Embedded</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>ATRIBUTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- logradouro: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- numero: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- bairro: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- cidade: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- uf: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">- referencia: String [0..1]</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>MÉTODOS DE DOMÍNIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">Valor: substituído integralmente</FONT></TD></TR></TABLE>>];
enums [label=<<TABLE BORDER="1" COLOR="#B6C6D9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#4D6479" CELLPADDING="10"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="14"><B>Enumerações</B></FONT><BR/><FONT COLOR="#CFE5F7" POINT-SIZE="9">«Enumeration»</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>ATRIBUTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">StatusOcorrencia:</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">PENDENTE | EM_ANDAMENTO | CONCLUIDA</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">TipoOcorrencia:</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">VAZAMENTO_AGUA | ESGOTO_CEU_ABERTO</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">FALTA_ABASTECIMENTO | OUTROS</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DCE9F7" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10"><B>MÉTODOS DE DOMÍNIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F7FAFE" CELLPADDING="5"><FONT FACE="Helvetica" POINT-SIZE="10">Usadas como @Enumerated(STRING)</FONT></TD></TR></TABLE>>];
  { rank=same; cidadao; equipe; }
  { rank=same; historico; endereco; enums; }
  cidadao -> ocorrencia [dir=none, taillabel="1", headlabel="0..*", label="solicitante
@OneToMany / @ManyToOne", labeldistance=2.2];
  equipe -> ocorrencia [dir=none, taillabel="0..1", headlabel="0..*", label="responsável
@OneToMany / @ManyToOne", labeldistance=2.0];
  ocorrencia -> historico [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*", label="histórico / cascade ALL", labeldistance=2.1];
  ocorrencia -> endereco [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="localização / @Embedded", labeldistance=2.1];
  ocorrencia -> enums [style=dashed, arrowhead=vee, label="tipo e status", constraint=false];
  equipe -> historico [dir=none, taillabel="0..1", headlabel="0..*", label="autoria de status", constraint=false, color="#8796A7", fontcolor="#697A8D"];
}